# ──────────────────────────────────────────────────────────────────────────────
# ResGen — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values before running locally.
# On Vercel, add these via: Project Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# OpenAI API key (optional)
# Used by the "AI Generated" response mode to create profile-aware answers.
# Without this key the app falls back to random+profile generation automatically.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
